generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String              @id @default(uuid())
  name                String
  industry            String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  clientCode          String?
  email               String?
  phone               String?
  status              String              @default("ACTIVE")
  isActive            Boolean             @default(true)
  plan                String              @default("TRIAL")
  trialEndDate        DateTime?
  trialStartDate      DateTime?
  emailLimitResetDate DateTime?
  monthlyEmailsSent   Int                 @default(0)
  batches             Batch[]
  categories          Category[]
  clients             Client[]
  expiryAlerts        ExpiryAlert[]
  inventories         Inventory[]
  inventoryLedgers    InventoryLedger[]
  inventoryTransfers  InventoryTransfer[]
  locations           Location[]
  locationInventory   LocationInventory[]
  notifications       Notification[]
  payments            Payment[]
  pickLists           PickList[]
  products            Product[]
  purchaseOrders      PurchaseOrder[]
  receivings          Receiving[]
  salesOrders         SalesOrder[]
  shipments           Shipment[]
  stockAdjustments    StockAdjustment[]
  supportTickets      SupportTicket[]
  transfersIn         TransferOrder[]     @relation("DestCompany")
  transfersOut        TransferOrder[]     @relation("SourceCompany")
  users               User[]
  warehouses          Warehouse[]

  @@map("company")
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  password           String
  role               String
  status             String              @default("ACTIVE")
  companyId          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  jobTitle           String?
  phone              String?
  warehouseId        String?
  auditLogs          AuditLog[]
  createdTransfers   InventoryTransfer[] @relation("TransferCreatedUser")
  notifications      Notification[]
  receivings         Receiving[]         @relation("InspectorUser")
  createdAdjustments StockAdjustment[]   @relation("AdjustmentCreatedUser")
  supportTickets     SupportTicket[]
  company            Company?            @relation(fields: [companyId], references: [id])
  warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id])
  managedWarehouses  Warehouse[]         @relation("WarehouseManager")

  @@index([companyId], map: "user_companyId_fkey")
  @@index([warehouseId], map: "user_warehouseId_fkey")
  @@map("user")
}

model Client {
  id              String       @id @default(uuid())
  name            String
  creditLimit     Float        @default(0)
  tier            String       @default("STANDARD")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  address         String?
  email           String?
  phone           String?
  status          String       @default("ACTIVE")
  companyId       String?
  gstNumber       String?
  password        String?
  shippingAddress String?
  warehouseId     String?
  company         Company?     @relation(fields: [companyId], references: [id])
  warehouse       Warehouse?   @relation(fields: [warehouseId], references: [id])
  salesOrders     SalesOrder[]

  @@index([companyId], map: "client_companyId_fkey")
  @@index([warehouseId], map: "client_warehouseId_fkey")
  @@map("client")
}

model AuditLog {
  id        String   @id @default(uuid())
  event     String
  userId    String?
  ipAddress String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "auditlog_userId_fkey")
  @@map("auditlog")
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("systemsettings")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  code        String?
  description String?
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  company     Company   @relation(fields: [companyId], references: [id])
  products    Product[]

  @@index([companyId], map: "category_companyId_fkey")
  @@map("category")
}

model Product {
  id                  String                @id @default(uuid())
  sku                 String
  name                String
  category            String?
  unitCost            Float                 @default(0)
  wholesalePrice      Float                 @default(0)
  companyId           String
  status              String                @default("ACTIVE")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  barcode             String?
  categoryId          String?
  deletedAt           DateTime?
  description         String?
  availableStock      Int                   @default(0)
  committedStock      Int                   @default(0)
  brand               String?
  storageType         String                @default("General Storage")
  trackingMethod      String                @default("None")
  uom                 String                @default("Piece")
  attributes          String?               @db.LongText
  barcodes            Barcode[]
  batches             Batch[]
  expiryAlerts        ExpiryAlert[]
  inventories         Inventory[]
  inventory           InventoryLedger[]
  locationInventories LocationInventory[]
  pickListItems       PickListItem[]
  categoryRef         Category?             @relation(fields: [categoryId], references: [id])
  company             Company               @relation(fields: [companyId], references: [id])
  specification       ProductSpecification?
  purchaseOrderItems  PurchaseOrderItem[]
  receivingItems      ReceivingItem[]
  salesOrderItems     SalesOrderItem[]
  stockAdjustments    StockAdjustment[]
  transferItems       TransferItem[]
  transferOrders      TransferOrder[]

  @@index([categoryId], map: "product_categoryId_fkey")
  @@index([companyId], map: "product_companyId_fkey")
  @@map("product")
}

model ProductSpecification {
  id        String  @id @default(uuid())
  productId String  @unique
  weight    Float?
  length    Float?
  width     Float?
  height    Float?
  volume    Float?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("productspecification")
}

model Receiving {
  id              String          @id @default(uuid())
  receivingNumber String          @unique
  poNumber        String?
  supplier        String
  status          String          @default("PENDING")
  receivedAt      DateTime        @default(now())
  inspectorId     String?
  notes           String?
  companyId       String
  createdBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  warehouse       String?
  company         Company         @relation(fields: [companyId], references: [id])
  inspector       User?           @relation("InspectorUser", fields: [inspectorId], references: [id])
  items           ReceivingItem[]

  @@index([companyId], map: "receiving_companyId_fkey")
  @@index([inspectorId], map: "receiving_inspectorId_fkey")
  @@map("receiving")
}

model ReceivingItem {
  id              String    @id @default(uuid())
  receivingId     String
  productId       String
  expectedQty     Int
  receivedQty     Int       @default(0)
  acceptedQty     Int       @default(0)
  rejectedQty     Int       @default(0)
  rejectionReason String?
  companyId       String
  createdAt       DateTime  @default(now())
  batches         Batch[]
  product         Product   @relation(fields: [productId], references: [id])
  receiving       Receiving @relation(fields: [receivingId], references: [id])

  @@index([productId], map: "receivingitem_productId_fkey")
  @@index([receivingId], map: "receivingitem_receivingId_fkey")
  @@map("receivingitem")
}

model Batch {
  id                  String              @id @default(uuid())
  lotId               String?
  productId           String
  companyId           String
  mfgDate             DateTime?
  expiryDate          DateTime?
  quarantine          Boolean             @default(false)
  coaLocked           Boolean             @default(true)
  testCertificateId   String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  acceptedQty         Int                 @default(0)
  lotNumber           String?
  receivingItemId     String?
  status              String              @default("QUARANTINE")
  barcodes            Barcode[]
  company             Company             @relation(fields: [companyId], references: [id])
  product             Product             @relation(fields: [productId], references: [id])
  receivingItem       ReceivingItem?      @relation(fields: [receivingItemId], references: [id])
  expiryAlerts        ExpiryAlert[]
  inventoryLedgers    InventoryLedger[]
  locationInventories LocationInventory[]
  pickListItems       PickListItem[]
  stockAdjustments    StockAdjustment[]
  transferItems       TransferItem[]

  @@index([companyId], map: "batch_companyId_fkey")
  @@index([productId], map: "batch_productId_fkey")
  @@index([receivingItemId], map: "batch_receivingItemId_fkey")
  @@map("batch")
}

model Barcode {
  id             String   @id @default(uuid())
  code           String   @unique
  barcodeType    String   @default("CODE128")
  productId      String
  batchId        String
  companyId      String
  createdAt      DateTime @default(now())
  trackingStatus String   @default("GENERATED")
  batch          Batch    @relation(fields: [batchId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])

  @@index([batchId], map: "barcode_batchId_fkey")
  @@index([productId], map: "barcode_productId_fkey")
  @@map("barcode")
}

model Location {
  id                  String              @id @default(uuid())
  zone                String
  aisle               String
  rack                String
  shelf               String
  maxCapacity         Int                 @default(1000)
  occupied            Int                 @default(0)
  status              String              @default("Active")
  companyId           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  bin                 String              @default("A1")
  code                String?
  deletedAt           DateTime?
  name                String?
  warehouse           String              @default("Main Warehouse")
  capacityType        String              @default("Items")
  inventoryLedgers    InventoryLedger[]
  destTransfers       InventoryTransfer[] @relation("DestLocation")
  sourceTransfers     InventoryTransfer[] @relation("SourceLocation")
  company             Company             @relation(fields: [companyId], references: [id])
  locationInventories LocationInventory[]
  stockAdjustments    StockAdjustment[]

  @@index([companyId], map: "location_companyId_fkey")
  @@map("location")
}

model Warehouse {
  id                  String              @id @default(uuid())
  name                String
  code                String?
  address             String?
  city                String?
  state               String?
  country             String?
  zipCode             String?
  managerName         String?
  contactPhone        String?
  facilityType        String?
  supportedItems      String?
  companyId           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  capacityType        String?
  capacityValue       Float?
  managerId           String?
  clients             Client[]
  locationInventories LocationInventory[]
  users               User[]
  company             Company             @relation(fields: [companyId], references: [id])
  manager             User?               @relation("WarehouseManager", fields: [managerId], references: [id])

  @@index([companyId], map: "Warehouse_companyId_fkey")
  @@index([managerId], map: "Warehouse_managerId_fkey")
  @@map("warehouse")
}

model LocationInventory {
  id           String     @id @default(uuid())
  locationId   String
  productId    String
  lotId        String?
  quantity     Int        @default(0)
  companyId    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  available    Int        @default(0)
  batchNumber  String?
  expiryDate   DateTime?
  lotNumber    String?
  reserved     Int        @default(0)
  serialNumber String?
  warehouseId  String?
  company      Company    @relation(fields: [companyId], references: [id])
  location     Location   @relation(fields: [locationId], references: [id])
  batch        Batch?     @relation(fields: [lotId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([locationId, productId, lotId])
  @@index([companyId], map: "locationinventory_companyId_fkey")
  @@index([lotId], map: "locationinventory_lotId_fkey")
  @@index([productId], map: "locationinventory_productId_fkey")
  @@index([warehouseId], map: "locationinventory_warehouseId_fkey")
  @@map("locationinventory")
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String
  companyId      String
  totalStock     Int      @default(0)
  reservedStock  Int      @default(0)
  availableStock Int      @default(0)
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])

  @@unique([productId, companyId])
  @@index([companyId], map: "inventory_companyId_fkey")
  @@map("inventory")
}

model InventoryLedger {
  id               String    @id @default(uuid())
  productId        String
  companyId        String
  location         String?
  quantityDelta    Int
  movementType     String
  timestamp        DateTime  @default(now())
  createdBy        String?
  destLocationId   String?
  locationId       String?
  lotId            String?
  notes            String?
  referenceId      String?
  sourceLocationId String?
  company          Company   @relation(fields: [companyId], references: [id])
  locRef           Location? @relation(fields: [locationId], references: [id])
  batch            Batch?    @relation(fields: [lotId], references: [id])
  product          Product   @relation(fields: [productId], references: [id])

  @@index([companyId], map: "inventoryledger_companyId_fkey")
  @@index([locationId], map: "inventoryledger_locationId_fkey")
  @@index([lotId], map: "inventoryledger_lotId_fkey")
  @@index([productId], map: "inventoryledger_productId_fkey")
  @@map("inventoryledger")
}

model InventoryTransfer {
  id               String         @id @default(uuid())
  transferNumber   String         @unique
  transferType     String         @default("BIN_TO_BIN")
  sourceLocationId String
  destLocationId   String
  status           String         @default("PENDING")
  companyId        String
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  company          Company        @relation(fields: [companyId], references: [id])
  creator          User?          @relation("TransferCreatedUser", fields: [createdBy], references: [id])
  destLocation     Location       @relation("DestLocation", fields: [destLocationId], references: [id])
  sourceLocation   Location       @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  items            TransferItem[]

  @@index([companyId], map: "inventorytransfer_companyId_fkey")
  @@index([createdBy], map: "inventorytransfer_createdBy_fkey")
  @@index([destLocationId], map: "inventorytransfer_destLocationId_fkey")
  @@index([sourceLocationId], map: "inventorytransfer_sourceLocationId_fkey")
  @@map("inventorytransfer")
}

model TransferItem {
  id         String            @id @default(uuid())
  transferId String
  productId  String
  lotId      String
  quantity   Int
  batch      Batch             @relation(fields: [lotId], references: [id])
  product    Product           @relation(fields: [productId], references: [id])
  transfer   InventoryTransfer @relation(fields: [transferId], references: [id])

  @@index([lotId], map: "transferitem_lotId_fkey")
  @@index([productId], map: "transferitem_productId_fkey")
  @@index([transferId], map: "transferitem_transferId_fkey")
  @@map("transferitem")
}

model StockAdjustment {
  id               String   @id @default(uuid())
  adjustmentNumber String   @unique
  productId        String
  lotId            String
  locationId       String
  quantityDelta    Int
  reasonCode       String
  notes            String?
  createdBy        String?
  companyId        String
  createdAt        DateTime @default(now())
  company          Company  @relation(fields: [companyId], references: [id])
  creator          User?    @relation("AdjustmentCreatedUser", fields: [createdBy], references: [id])
  location         Location @relation(fields: [locationId], references: [id])
  batch            Batch    @relation(fields: [lotId], references: [id])
  product          Product  @relation(fields: [productId], references: [id])

  @@index([companyId], map: "stockadjustment_companyId_fkey")
  @@index([createdBy], map: "stockadjustment_createdBy_fkey")
  @@index([locationId], map: "stockadjustment_locationId_fkey")
  @@index([lotId], map: "stockadjustment_lotId_fkey")
  @@index([productId], map: "stockadjustment_productId_fkey")
  @@map("stockadjustment")
}

model ExpiryAlert {
  id            String   @id @default(uuid())
  lotId         String
  productId     String
  expiryDate    DateTime
  daysRemaining Int
  alertTier     String
  resolved      Boolean  @default(false)
  companyId     String
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id])
  batch         Batch    @relation(fields: [lotId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])

  @@index([companyId], map: "expiryalert_companyId_fkey")
  @@index([lotId], map: "expiryalert_lotId_fkey")
  @@index([productId], map: "expiryalert_productId_fkey")
  @@map("expiryalert")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  supplier         String
  expectedDelivery DateTime?
  totalCost        Float               @default(0)
  status           String              @default("PENDING")
  companyId        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  poNumber         String              @unique
  company          Company             @relation(fields: [companyId], references: [id])
  items            PurchaseOrderItem[]

  @@index([companyId], map: "purchaseorder_companyId_fkey")
  @@map("purchaseorder")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Float         @default(0)
  product         Product       @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([productId], map: "purchaseorderitem_productId_fkey")
  @@index([purchaseOrderId], map: "purchaseorderitem_purchaseOrderId_fkey")
  @@map("purchaseorderitem")
}

model TransferOrder {
  id                   String   @id @default(uuid())
  sourceCompanyId      String
  destinationCompanyId String
  productId            String
  quantity             Int
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  destinationCompany   Company  @relation("DestCompany", fields: [destinationCompanyId], references: [id])
  product              Product  @relation(fields: [productId], references: [id])
  sourceCompany        Company  @relation("SourceCompany", fields: [sourceCompanyId], references: [id])

  @@index([destinationCompanyId], map: "transferorder_destinationCompanyId_fkey")
  @@index([productId], map: "transferorder_productId_fkey")
  @@index([sourceCompanyId], map: "transferorder_sourceCompanyId_fkey")
  @@map("transferorder")
}

model PickList {
  id        String         @id @default(uuid())
  orderId   String
  status    String         @default("PENDING")
  companyId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id])
  items     PickListItem[]

  @@index([companyId], map: "picklist_companyId_fkey")
  @@map("picklist")
}

model PickListItem {
  id             String   @id @default(uuid())
  pickListId     String
  productId      String
  batchId        String?
  binLocation    String
  targetQuantity Int
  pickedQuantity Int      @default(0)
  picked         Boolean  @default(false)
  batch          Batch?   @relation(fields: [batchId], references: [id])
  pickList       PickList @relation(fields: [pickListId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])

  @@index([batchId], map: "picklistitem_batchId_fkey")
  @@index([pickListId], map: "picklistitem_pickListId_fkey")
  @@index([productId], map: "picklistitem_productId_fkey")
  @@map("picklistitem")
}

model SalesOrder {
  id              String           @id @default(uuid())
  clientId        String
  companyId       String
  status          String           @default("PENDING_REVIEW")
  rejectionReason String?
  totalCost       Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderNumber     String?          @unique
  priority        String?          @default("NORMAL")
  notes           String?
  poNumber        String?
  shippingAddress String?
  client          Client           @relation(fields: [clientId], references: [id])
  company         Company          @relation(fields: [companyId], references: [id])
  items           SalesOrderItem[]

  @@index([clientId], map: "salesorder_clientId_fkey")
  @@index([companyId], map: "salesorder_companyId_fkey")
  @@map("salesorder")
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Int
  product      Product    @relation(fields: [productId], references: [id])
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@index([productId], map: "salesorderitem_productId_fkey")
  @@index([salesOrderId], map: "salesorderitem_salesOrderId_fkey")
  @@map("salesorderitem")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  companyId String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([companyId], map: "notification_companyId_fkey")
  @@index([userId], map: "notification_userId_fkey")
  @@map("notification")
}

model Shipment {
  id                String   @id @default(uuid())
  trackingNumber    String   @unique
  carrier           String
  orderId           String
  recipient         String
  destination       String
  estimatedDelivery String?
  status            String   @default("LABEL_CREATED")
  labelUrl          String?
  companyId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "shipment_companyId_fkey")
  @@map("shipment")
}

model Plan {
  id           String    @id @default(uuid())
  name         String
  price        Float
  durationDays Int       @default(30)
  features     String?   @db.LongText
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]

  @@map("plan")
}

model SupportTicket {
  id          String          @id @default(uuid())
  title       String
  description String          @db.Text
  status      String          @default("OPEN")
  priority    String          @default("MEDIUM")
  companyId   String
  userId      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  company     Company         @relation(fields: [companyId], references: [id])
  user        User?           @relation(fields: [userId], references: [id])
  messages    TicketMessage[]

  @@index([companyId], map: "supportticket_companyId_fkey")
  @@index([userId], map: "supportticket_userId_fkey")
  @@map("supportticket")
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  senderId   String?
  senderRole String
  message    String        @db.Text
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "ticketmessage_ticketId_fkey")
  @@map("ticketmessage")
}

model Payment {
  id            String   @id @default(uuid())
  companyId     String
  planId        String?
  amount        Float
  currency      String   @default("INR")
  status        String   @default("PENDING")
  transactionId String?
  paymentDate   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id])
  plan          Plan?    @relation(fields: [planId], references: [id])

  @@index([companyId], map: "payment_companyId_fkey")
  @@index([planId], map: "payment_planId_fkey")
  @@map("payment")
}
